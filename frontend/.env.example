# Clerk publishable key for frontend authentication.
VITE_CLERK_PUBLISHABLE_KEY=

# Base URL of the FastAPI backend, with no trailing slash.
# Defaults to http://127.0.0.1:8000 when unset.
VITE_API_URL=

# Match backend STORAGE_PUBLIC_BASE_URL. Local API image URLs are rewritten to
# Vite's /r2 proxy, which forwards them through the production Vercel R2 rewrite.
VITE_R2_PUBLIC_URL=https://pub-faa5f7e843ea40be96bbaa950ecc40d1.r2.dev

# Landing snapshot URL. Production uses Vercel's same-origin cached R2 proxy.
VITE_LANDING_SNAPSHOT_URL=/landing/v1/snapshot.json
