# This file is never loaded by the application. Use only for explicit test DB
# commands, after confirming this URL points at an isolated database.
TEST_DATABASE_URL=postgresql://test:test@127.0.0.1:5432/ddc_stage1_test
# Remote tests require an explicit opt-in and a separate Neon branch/host from
# DATABASE_URL. Keep false unless you are using that isolated branch.
ALLOW_REMOTE_TEST_DATABASE=false
