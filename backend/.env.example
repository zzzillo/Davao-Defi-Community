# Database URL for your application. This should be in the format:
DATABASE_URL=
# Clerk secret key for your application. This should be in the format:
CLERK_SECRET_KEY=
# Signing secret for Clerk webhooks, from Dashboard > Webhooks > your endpoint.
# Starts with "whsec_". Used to verify that webhook requests really came from Clerk.
CLERK_WEBHOOK_SIGNING_SECRET=
# Origin your object storage bucket is served from, with no trailing slash.
# Cloudflare R2 gives you a "https://pub-<id>.r2.dev" URL, or your own domain.
# Optional: leave it blank until R2 is configured. Stored image keys simply
# resolve to no URL until it is set.
STORAGE_PUBLIC_BASE_URL=
