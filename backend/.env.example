# PostgreSQL connection URL. postgresql:// and postgres:// are normalized to
# the async psycopg driver; URL-encode special characters in credentials.
DATABASE_URL=
# Separate owner/migration credential for Alembic. Optional in local development,
# required and direct/non-pooled on Render and in production. Runtime requests
# must use DATABASE_URL, which can remain pooled.
MIGRATION_DATABASE_URL=
# Optional direct PostgreSQL URL for long-lived LISTEN/NOTIFY. Neon pooled
# DATABASE_URL values derive the direct hostname automatically; set this when
# your provider uses a pooler that does not retain LISTEN sessions.
DATABASE_LISTEN_URL=

# Clerk secrets. The database health endpoint does not require either value.
CLERK_SECRET_KEY=
# The exact `iss` value expected on signed Clerk session tokens. Copy it from
# a verified Clerk session token's issuer (or your instance's Frontend API URL).
CLERK_ISSUER_URL=
# Starts with whsec_. Used only by the signed Clerk webhook route.
CLERK_WEBHOOK_SIGNING_SECRET=

# Comma-separated browser origins. Include the Vite port you use locally.
ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Stage 4 image storage. Uploads return 503 until all five values are configured.
# Use an HTTPS public development URL while testing; switch to a custom domain
# for production. This URL may include a simple path prefix, without a query.
STORAGE_PUBLIC_BASE_URL=
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Set true on the backend serving the database that owns the public landing page.
LANDING_SNAPSHOT_ENABLED=false

# Set APP_ENV=production on Render. Rate limits require a shared Redis-compatible
# Render Key Value URL in production; do not expose this value to the frontend.
APP_ENV=development
RATE_LIMIT_REDIS_URL=
# Docs default on in development and off in production; set explicitly only
# when you need to override that default.
# API_DOCS_ENABLED=true

# Optional per-window limits; defaults are conservative and use these windows.
# Public read defaults: 120/minute and 1200/10 minutes.
# Other defaults: sync 5/minute + 30/hour; uploads 10/minute + 60/hour;
# writes 30/minute + 300/hour; admin 120/minute + 1200/hour;
# Clerk webhook 120/minute + 2400/hour; realtime 3/minute + 10/10 minutes.
# RATE_LIMIT_PUBLIC_READ_PER_MINUTE=
# RATE_LIMIT_PUBLIC_READ_PER_10_MINUTES=
# RATE_LIMIT_USER_SYNC_PER_MINUTE=
# RATE_LIMIT_USER_SYNC_PER_HOUR=
# RATE_LIMIT_UPLOAD_PER_MINUTE=
# RATE_LIMIT_UPLOAD_PER_HOUR=
# RATE_LIMIT_WRITE_PER_MINUTE=
# RATE_LIMIT_WRITE_PER_HOUR=
# RATE_LIMIT_ADMIN_PER_MINUTE=
# RATE_LIMIT_ADMIN_PER_HOUR=
# RATE_LIMIT_WEBHOOK_PER_MINUTE=
# RATE_LIMIT_WEBHOOK_PER_HOUR=
# RATE_LIMIT_REALTIME_PER_MINUTE=
# RATE_LIMIT_REALTIME_PER_10_MINUTES=
